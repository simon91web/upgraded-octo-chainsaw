# Bibellese neben Yuvomi, hinter nginx. Gleiche Herkunft ist Pflicht: der Browser schickt
# das Yuvomi-Sitzungscookie an /api/extensions/bibellese/, und Yuvomis Service Worker lässt
# /api/ in Ruhe (MODULES.md).

server {
    listen 80;
    server_name yuvomi.example.org;

    location /api/extensions/bibellese/ {
        proxy_pass http://127.0.0.1:3100;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
    }
}
